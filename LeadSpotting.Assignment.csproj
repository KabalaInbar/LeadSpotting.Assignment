<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>45cc7879-dce1-42ad-99c0-ae4ad83a57c1</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);LeadSpotting.Assignment.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!-- Exclude test project files from being automatically compiled into the main project
       Tests are located under LeadSpotting.Assignment.Tests; remove them from this project
       so the separate test project can compile them. -->
  <ItemGroup>
    <Compile Remove="LeadSpotting.Assignment.Tests\**\*.cs" />
  </ItemGroup>

</Project>
